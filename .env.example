# --- PostgreSQL (비밀번호는 URL에 들어가므로 영문·숫자 위주로) ---
POSTGRES_USER=radar
POSTGRES_PASSWORD=
POSTGRES_DB=radar

TZ=Asia/Seoul

# --- 웹 ---
# 리버스 프록시(Caddy 등)를 앞에 둔다면 127.0.0.1 로 바꾸세요
WEB_BIND=0.0.0.0
WEB_PORT=1344

# --- 수집 일정 (TZ 기준 cron, 5필드) ---
COLLECT_CRON=40 8 * * *
# worker가 뜰 때마다 한 번 바로 수집할지
COLLECT_ON_START=false

# --- KISA 보호나라 보안공지 ---
KISA_ENABLED=true
KISA_PAGES=3

# --- 오늘의 AI 요약 (EXAONE) ---
# 키를 비워 두면 요약 카드가 나오지 않을 뿐 나머지는 그대로 동작합니다.
# 기본값은 LG AI연구원 EXAONE API 플랫폼의 K-EXAONE 2.5(750B, 활성 31B). 키는 docs.exaone.ai 에서 발급.
# FriendliAI 서버리스의 이전 모델을 쓰려면:
#   EXAONE_BASE_URL=https://api.friendli.ai/serverless/v1  EXAONE_MODEL=LGAI-EXAONE/K-EXAONE-236B-A23B  EXAONE_REASONING_EFFORT=
# 직접 띄운 vLLM/SGLang EXAONE이면 EXAONE_BASE_URL=http://<호스트>:8000/v1 처럼 바꾸면 됩니다.
EXAONE_API_KEY=
EXAONE_BASE_URL=https://api.exaone.ai/v1
EXAONE_MODEL=k-exaone_v2.5
# K-EXAONE 2.5는 추론을 끌 수 없고 양만 조절합니다: low | high | max (API 기본은 max)
# 비워 두면 이 값을 보내지 않고, 대신 아래 EXAONE_THINKING 스위치를 씁니다(이전 EXAONE용).
EXAONE_REASONING_EFFORT=low
EXAONE_THINKING=false
# 추론 토큰까지 포함한 한도. 너무 작으면 답을 쓰기 전에 잘려 요약이 실패합니다.
SUMMARY_MAX_TOKENS=8000

# --- LibreTranslate ---
LT_IMAGE=libretranslate/libretranslate:latest
LT_LOAD_ONLY=en,ko
LT_THREADS=4
LT_API_KEY=
LT_BATCH=8
LT_CONCURRENCY=2
# 15~90일 지난 Critical, GitHub 패키지 권고 요약까지 번역할지
TRANSLATE_ARCHIVE=true
TRANSLATE_PACKAGES=true
