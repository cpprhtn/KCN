# --- PostgreSQL (비밀번호는 URL에 들어가므로 영문·숫자 위주로) ---
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=radar

TZ=Asia/Seoul

# --- 웹 ---
# 리버스 프록시(Caddy 등)를 앞에 둔다면 127.0.0.1 로 바꾸세요
WEB_BIND=0.0.0.0
WEB_PORT=8080

# --- 수집 일정 (TZ 기준 cron, 5필드) ---
COLLECT_CRON=40 8 * * *
# worker가 뜰 때마다 한 번 바로 수집할지
COLLECT_ON_START=false

# --- KISA 보호나라 보안공지 ---
KISA_ENABLED=true
KISA_PAGES=3

# --- 오늘의 AI 요약 (EXAONE) ---
# 키를 비워 두면 요약 카드가 나오지 않을 뿐 나머지는 그대로 동작합니다.
# 기본값은 FriendliAI 서버리스(OpenAI 호환). 콘솔에 보이는 모델 이름으로 EXAONE_MODEL을 맞추세요.
# 직접 띄운 vLLM/SGLang EXAONE이면 EXAONE_BASE_URL=http://<호스트>:8000/v1 처럼 바꾸면 됩니다.
EXAONE_API_KEY=
EXAONE_BASE_URL=https://api.friendli.ai/serverless/v1
EXAONE_MODEL=LGAI-EXAONE/K-EXAONE-236B-A23B
# 추론(thinking) 모드: 느리고 토큰을 더 쓰므로 기본은 끔
EXAONE_THINKING=false
SUMMARY_MAX_TOKENS=1500

# --- LibreTranslate ---
LT_IMAGE=libretranslate/libretranslate:latest
LT_LOAD_ONLY=en,ko
LT_THREADS=4
LT_API_KEY=
LT_BATCH=8
LT_CONCURRENCY=2
# 15~90일 지난 Critical, GitHub 패키지 권고 요약까지 번역할지
TRANSLATE_ARCHIVE=true
TRANSLATE_PACKAGES=true
