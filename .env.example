# --- PostgreSQL (비밀번호는 URL에 들어가므로 영문·숫자 위주로) ---
POSTGRES_USER=radar
POSTGRES_PASSWORD=
POSTGRES_DB=radar

TZ=Asia/Seoul

# --- 웹 ---
# 리버스 프록시(Caddy 등)를 앞에 둔다면 127.0.0.1 로 바꾸세요
WEB_BIND=0.0.0.0
WEB_PORT=1344

# --- 수집 일정 (TZ 기준 cron, 5필드) ---
COLLECT_CRON=40 8 * * *
# worker가 뜰 때마다 한 번 바로 수집할지
COLLECT_ON_START=false

# --- KISA 보호나라 보안공지 ---
KISA_ENABLED=true
KISA_PAGES=3

# --- 오늘의 AI 요약 (ChatGPT / OpenAI API) ---
# 키를 비워 두면 요약 카드가 나오지 않을 뿐 나머지는 그대로 동작합니다. 키는 platform.openai.com 에서 발급.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
# 추론 모델(gpt-5 계열, o 시리즈)의 추론 양: minimal | low | medium | high
# gpt-4o·gpt-4.1처럼 추론을 안 하는 모델이면 비워 두세요(값을 보내지 않음).
OPENAI_REASONING_EFFORT=low
# 비워 두면 보내지 않습니다. 추론 모델은 기본값만 받으니 gpt-4o 등에서만 쓰세요(예: 0.3).
OPENAI_TEMPERATURE=
# POST /api/summarize 로 지금 바로 요약을 쓰게 하는 키(Ed25519 개인키, base64 또는 PEM).
# 요청 본문의 public_key 가 이 개인키의 공개키와 일치할 때만 요약합니다. 비워 두면 이 기능은 꺼집니다.
# 키 쌍은 내 PC에서 만들어 값만 넣으면 됩니다(서버에서 실행할 필요 없음):
#   sh scripts/summary-keygen.sh        (OpenSSL만 있으면 됨. Windows는 Git Bash에서)
# PaaS 환경변수 칸에는 SUMMARY_PRIVATE_KEY= 뒤의 한 줄짜리 base64 값만 넣으세요.
SUMMARY_PRIVATE_KEY=
# 요약을 쓰는 시각(TZ 기준 cron). 기본: 매일 오전 7시, 낮 12시, 저녁 7시. 모든 요약은 summary_history에 보관됩니다.
SUMMARY_CRON=0 7,12,19 * * *
# 요약 시각에 데이터가 이 시간보다 오래됐으면 먼저 증분 수집을 돌립니다.
SUMMARY_FRESH_HOURS=3
# 추론 토큰까지 포함한 한도. 너무 작으면 답을 쓰기 전에 잘려 요약이 실패합니다.
SUMMARY_MAX_TOKENS=8000

# --- LibreTranslate ---
LT_IMAGE=libretranslate/libretranslate:latest
LT_LOAD_ONLY=en,ko
LT_THREADS=4
LT_API_KEY=
LT_BATCH=8
LT_CONCURRENCY=2
# 15~90일 지난 Critical, GitHub 패키지 권고 요약까지 번역할지
TRANSLATE_ARCHIVE=true
TRANSLATE_PACKAGES=true

# --- RSS 피드 (KNVD 등) ---
# 피드는 최신 10건 정도만 보여 주므로 자주 읽어 rss_items 테이블에 계속 쌓습니다(삭제하지 않음).
RSS_ENABLED=true
RSS_INTERVAL_MIN=30
# "이름|표시 이름|URL" 을 ; 로 구분. 이름은 영문 소문자·숫자·-_ (한 번 정하면 바꾸지 마세요: 저장 키로 쓰입니다)
# 영어 피드를 추가하면 제목·본문 앞부분을 LibreTranslate로 한국어 번역해 보여 줍니다. 예:
#   ...;cisa|CISA 권고|https://www.cisa.gov/cybersecurity-advisories/all.xml
RSS_FEEDS=knvd-notice|KNVD 보안공지|https://knvd.krcert.or.kr/rss/security/notice;knvd-vuln|KNVD 공개 취약점|https://knvd.krcert.or.kr/rss/security/info
